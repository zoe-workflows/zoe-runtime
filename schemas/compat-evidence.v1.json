{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zoe-runtime.local/schemas/compat-evidence.v1.json",
  "title": "compatibility_evidence file",
  "description": "Operator-declared verification record. A record proves one exact (adapter_id, backend, version) combination; it never unlocks another backend. source=real_e2e is a real end-to-end run; local_admin is an administrator declaration and is labelled as such in `zoe agent list`.",
  "type": "object",
  "required": ["records"],
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["adapter_id", "backend", "version", "source", "platform", "recorded_at"],
        "additionalProperties": false,
        "properties": {
          "adapter_id": {"enum": ["codebuddy", "opencode", "claude-code", "codex"]},
          "backend": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1, "description": "Exact CLI version; ranges are not accepted."},
          "source": {"enum": ["real_e2e", "local_admin"]},
          "platform": {"type": "string", "minLength": 1},
          "matrix": {"enum": ["builtin", "extended"]},
          "recorded_at": {"type": "string", "minLength": 1},
          "evidence_ref": {"type": "string"}
        }
      }
    }
  }
}
